# GEMINI_API_KEY: Required server-side secret for Google Gen AI SDK (@google/genai) calls.
# AI Studio automatically injects this at runtime from user secrets.
# Never expose this variable with a VITE_ prefix so it remains strictly server-side.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
APP_URL="MY_APP_URL"

# PORT: Server port (defaults to 3000 in AI Studio environment).
PORT="3000"
